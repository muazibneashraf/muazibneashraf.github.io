# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

/.sites-runtime/
/data/messages.json
*.tsbuildinfo

# Local visual verification artifacts
/tmp/

# Uploaded résumé documents use the configured content store
/data/resumes/

# Generated from the pinned PDF.js package before dev/build
/public/pdfjs/

/build/bg05-*
/.codex-tmp/
/.openai/
